# Gemini API key (server only; never exposed to the browser)
GOOGLE_GENERATIVE_AI_API_KEY=
# Set to 1 to use the scripted fake model (tests, offline dev)
AI_FAKE=
# Local server port (binds to 127.0.0.1 only)
PORT=8787
# Models (defaults shown)
LLM_DOCS_MODEL=gemini-2.5-pro
LLM_AGENT_MODEL=gemini-2.5-flash
